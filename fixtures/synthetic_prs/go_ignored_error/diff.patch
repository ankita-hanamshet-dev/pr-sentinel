diff --git a/config/report.go b/config/report.go
index 3a1f9c2..b7e40d1 100644
--- a/config/report.go
+++ b/config/report.go
@@ -12,8 +12,29 @@ type Report struct {
 func (r *Report) Total() int {
 	return r.Findings + r.Score
 }
 
+// WriteReport serializes r as JSON to w and closes w when done.
+func WriteReport(w io.WriteCloser, r *Report) error {
+	defer func() { _ = w.Close() }()
+	enc := json.NewEncoder(w)
+	return enc.Encode(r)
+}
+
+// LoadReport reads a serialized report from the file at path.
+func LoadReport(path string) (*Report, error) {
+	f, _ := os.Open(path)
+	defer f.Close()
+	data, err := io.ReadAll(f)
+	if err != nil {
+		return nil, err
+	}
+	var rep Report
+	if err := json.Unmarshal(data, &rep); err != nil {
+		return nil, err
+	}
+	return &rep, nil
+}
 
 func (r *Report) IsClean() bool {
 	return r.Findings == 0
 }
