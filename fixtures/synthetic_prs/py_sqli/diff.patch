+def search_users_by_email(conn: sqlite3.Connection, email_fragment: str) -> list[sqlite3.Row]:
+    cursor = conn.cursor()
+    query = "SELECT * FROM users WHERE email LIKE '%" + email_fragment + "%'"
+    cursor.execute(query)
+    return cursor.fetchall()
