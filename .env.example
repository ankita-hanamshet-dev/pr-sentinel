# Copy this file to .env and fill in real values. Do NOT commit .env.

# Fine-grained GitHub PAT with models:read + repo access
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# LLM provider (e.g. github, openai, anthropic)
PR_SENTINEL_LLM_PROVIDER=github

# Model identifier for the chosen provider
PR_SENTINEL_MODEL=openai/gpt-4o
