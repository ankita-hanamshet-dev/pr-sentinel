# Copy this file to .env and fill in real values. Do NOT commit .env.

# --- GitHub access -----------------------------------------------------------
# Fine-grained PAT for reading PRs (Contents + Pull requests: Read).
# NOTE: GitHub Models was retired 2026-07-30, so models:read is NOT needed.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# --- LLM provider (configurable) ---------------------------------------------
# Swap these to change providers with no code change.
# Default: Anthropic (Claude). For the demo, set these to the TCS-provided values.
PR_SENTINEL_LLM_PROVIDER=anthropic
PR_SENTINEL_MODEL=claude-sonnet-5

# API key for the selected provider (Anthropic key now; TCS key at demo time).
PR_SENTINEL_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the API base URL for OpenAI-compatible / Azure / TCS
# endpoints. Leave blank to use the provider's default endpoint.
# PR_SENTINEL_LLM_BASE_URL=
